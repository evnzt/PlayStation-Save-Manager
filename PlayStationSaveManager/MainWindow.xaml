                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="SAVE PROGRESS"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Play Time" Foreground="#7F93AA"/>
                                        <TextBlock x:Name="SaveInfoPlayTime" Grid.Column="1"
                                                   Text="Not supported for this title" Foreground="#9FB0C5"/>

                                        <TextBlock Grid.Row="1" Text="Game-Specific Data" Foreground="#7F93AA" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="SaveInfoParserStatus" Grid.Row="1" Grid.Column="1"
                                                   Text="No parser is available yet." Foreground="#9FB0C5"
                                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="Future game-specific parsers can add completion, money, cars, garage contents, difficulty, chapters, and other supported values here."
                                               Foreground="#71869F"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="UniversalImportWizardTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconImportWizardNew}" Style="{StaticResource TabIcon}"/>
                        <TextBlock Text="Import Wizard" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="24"
                      AllowDrop="True"
                      DragOver="ImportWizard_DragOver"
                      Drop="ImportWizard_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.92*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="UNIVERSAL IMPORT WIZARD"
                                       FontSize="25"
                                       FontWeight="Bold"/>
                            <TextBlock Grid.Row="1"
                                       Text="Drop any supported PS2 save or memory card here. PSM detects it and presents the actions that make sense."
                                       Foreground="#9FB0C5"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,20"/>

                            <Border Grid.Row="2"
                                    Background="#071019"
                                    BorderBrush="#2B4059"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="22"
                                    MinHeight="320">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                MaxWidth="560">
                                        <Image Source="{StaticResource IconImportWizardNew}"
                                               Width="66"
                                               Height="66"
                                               Stretch="Uniform"
                                               Opacity="0.92"
                                               Margin="0,0,0,18"/>
                                        <TextBlock x:Name="WizardDropTitle"
                                                   Text="Drop a save or memory card here"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <TextBlock x:Name="WizardDropSubtitle"
                                                   Text=".PSU  •  .MAX  •  .CBS  •  .XPS  •  .SPS  •  .PSV  •  .NPO  •  .P2M  •  .MC2  •  .PS2  •  .MCR  •  .SRM  •  .BIN  •  .MCD  •  .MC  •  .GME  •  .MEM  •  .VGS  •  .DDF  •  .PS  •  .PSM  •  .MCI  •  .VMP  •  .VM1"
                                                   Foreground="#8FA4BD"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,20"/>
                                        <Button Content="Browse for File"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="BrowseImportWizard_Click"
                                                HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            x:Name="WizardFilePanel"
                                            Visibility="Collapsed"
                                            Background="#05090E"
                                            BorderBrush="#22364E"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="12"
                                            Margin="0,18,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Source="{StaticResource IconImportWizardNew}"
                                                   Width="64"
                                                   Height="64"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.92"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="WizardFileName"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="WizardFileDetails"
                                                           Foreground="#91BDEB"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="WizardFilePath"
                                                           Foreground="#788BA3"
                                                           FontSize="11"
                                                           Margin="0,5,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="Clear"
                                                    Click="ClearImportWizard_Click"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="3"
                                       Text="The wizard routes each action through PSM’s existing Safe Transaction Mode. It does not bypass backups or verification."
                                       Foreground="#71869F"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="2,14,2,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="AVAILABLE ACTIONS"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="WizardDetectedType"
                                       Grid.Row="1"
                                       Text="Choose a file to see available actions."
                                       Foreground="#55A9FF"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,18"/>

                            <Button x:Name="WizardCardAButton"
                                    Grid.Row="2"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Import into Card A"
                                    Click="WizardCardA_Click"
                                    IsEnabled="False"
                                    Margin="0,0,0,12"/>

                            <Button x:Name="WizardCardBButton"
                                    Grid.Row="3"
                                    Style="{StaticResource PurpleButton}"
                                    Content="Import into Card B"
                                    Click="WizardCardB_Click"
                                    IsEnabled="False"
                                    Margin="0,0,0,12"/>

                            <Grid Grid.Row="4" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="WizardConvertButton"
                                        Grid.Column="0"
                                        Content="Convert"
                                        Click="WizardConvert_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="WizardLibraryButton"
                                        Grid.Column="2"
                                        Content="Add to Save Library"
                                        Click="WizardLibrary_Click"
                                        IsEnabled="False"/>
                            </Grid>

                            <Border Grid.Row="5"
                                    Background="#09111A"
                                    BorderBrush="#203149"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="WHAT PSM DETECTED"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,9"/>
                                    <TextBlock x:Name="WizardExplanation"
                                               Text="No source selected."
                                               Foreground="#AFC0D3"
                                               TextWrapping="Wrap"
                                               LineHeight="21"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="UniversalConverterTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconCopy}" Style="{StaticResource TabIcon}"/>
                        <TextBlock Text="Universal Converter" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.88*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="UNIVERSAL CONVERTER" FontSize="25" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1"
                                       Text="Convert supported PlayStation and PlayStation 2 saves or complete memory cards while preserving the original source."
                                       Foreground="#9FB0C5" TextWrapping="Wrap" Margin="0,6,0,22"/>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Source File" FontWeight="Bold"/>
                                <DockPanel Margin="0,7,0,7">
                                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseUniversalSource_Click"/>
                                    <TextBox x:Name="UniversalSourcePath" IsReadOnly="True"/>
                                </DockPanel>
                                <TextBlock x:Name="UniversalDetectedFormat" Text="Detected format: —"
                                           Foreground="#55A9FF" Margin="1,0,0,16"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Output Format" FontWeight="Bold"/>
                                <ComboBox x:Name="UniversalTargetFormat"
                                          Style="{StaticResource PolarisComboBox}"
                                          Margin="0,7,0,16"
                                          SelectionChanged="UniversalTargetFormat_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Output Path" FontWeight="Bold"/>
                                <DockPanel Margin="0,7,0,18">
                                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseUniversalOutput_Click"/>
                                    <TextBox x:Name="UniversalOutputPath"/>
                                </DockPanel>
                            </StackPanel>
                            <Border Grid.Row="5" Background="#09111A" BorderBrush="#203149"
                                    BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Supported Input Formats" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <TextBlock Text=".PSU  •  .MAX  •  .CBS  •  .XPS  •  .SPS  •  .PSV  •  .NPO  •  .P2M  •  .MC2  •  .PS2  •  .MCR  •  .SRM  •  .BIN  •  .MCD  •  .MC  •  .GME  •  .MEM  •  .VGS  •  .DDF  •  .PS  •  .PSM  •  .MCI  •  .VMP  •  .VM1"
                                               Foreground="#AFC1D7" TextWrapping="Wrap"/>
                                    <TextBlock Text="Verified output adapters write PSU, MAX, MC2, PS2, MCR, SRM, BIN, MCD, and MC. Additional legacy wrappers are recognized but not yet writable."
                                               Foreground="#7F93AA" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="UniversalConvertButton" Grid.Row="6"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Convert and Verify"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    IsEnabled="False" Click="UniversalConvert_Click"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CONVERSION REPORT" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="UniversalModeText" Grid.Row="1"
                                       Text="Choose a source file to begin."
                                       Foreground="#55A9FF" FontWeight="SemiBold" Margin="0,16,0,8"/>
                            <TextBlock x:Name="UniversalConversionReport" Grid.Row="2"
                                       Text="PSM detects whether the source is a packaged save or a complete memory card, then shows verified output choices."
                                       Foreground="#B6C5D7" TextWrapping="Wrap" FontSize="14" LineHeight="23"/>
                            <TextBox x:Name="UniversalTechnicalLog" Grid.Row="3" Margin="0,20,0,0"
                                     Background="#060A0F" Foreground="#9DB7D5" BorderBrush="#203149"
                                     FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconClipboard}" Style="{StaticResource TabIcon}"/><TextBlock Text="Activity Log" VerticalAlignment="Center"/></StackPanel></TabItem.Header><Grid Margin="18"><TextBox x:Name="ActivityLog" Background="#060A0F" Foreground="#BBD3EF" FontFamily="Consolas" FontSize="13" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Grid></TabItem>

            <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconNews}" Style="{StaticResource TabIcon}"/><TextBlock Text="About" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <Grid Margin="40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="760">
                        <Image Source="psm-logo.png" Width="460" Height="130" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        <TextBlock Text="PlayStation Save Manager" FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,24,0,4"/>
                        <TextBlock Text="Version 1.0.0" Foreground="#55A9FF" FontSize="16"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Import  •  Export  •  Save Transfer  •  Backup  •  Universal Converter"
                                   Foreground="#91BDEB" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,20"/>

                        <Border Height="1" Background="#26384F" Margin="70,0,70,22"/>

                        <TextBlock Text="Created by evnzt" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Engineering assistance by OpenAI ChatGPT."
                                   Foreground="#B7C5D7" FontSize="14" HorizontalAlignment="Center"/>

                        <Border Height="1" Background="#26384F" Margin="70,22,70,22"/>

                        <TextBlock Text="Special Thanks" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Special thanks to the developers of myMC++, mymc, MemcardRex, PS2 Save Builder, and PS2 Save Converter."
                                   Foreground="#B7C5D7" FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="680" LineHeight="22"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="#080E15" BorderBrush="#1C2B3C" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,10,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Card A Status     •     Verified protection" Foreground="#9EB0C5" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="◆" Foreground="#42E47B" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="Safe Transaction Mode Active" Foreground="#42E47B" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Grid.Column="2" Text="Card B Status     •     Verified protection" Foreground="#9EB0C5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,0" IsHitTestVisible="False"><ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Top" IsIndeterminate="False" Background="Transparent" Foreground="#1677FF"/><TextBlock x:Name="StatusText" Text="Ready." Visibility="Collapsed"/></Grid>
        </Grid>
    </DockPanel>
</Window>
