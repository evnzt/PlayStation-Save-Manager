                                        <TextBlock Grid.Row="2" Text="Size" Foreground="#7F93AA" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="SaveInfoSize" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,8,0,0"/>

                                        <TextBlock Grid.Row="3" Text="Added" Foreground="#7F93AA" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="SaveInfoAdded" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,8,0,0"/>

